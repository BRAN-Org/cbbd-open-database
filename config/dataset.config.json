{
  "organization": {
    "name": "BRAN Org",
    "url": "https://github.com/BRAN-Org",
    "logo": "https://avatars.githubusercontent.com/u/328064865?v=4",
    "institutionName": "BRAN Org",
    "githubUrl": "https://github.com/BRAN-Org/cbbd-open-database",
    "doiUrl": "https://doi.org/10.5281/zenodo.pending",
    "issuesUrl": "https://github.com/BRAN-Org/cbbd-open-database/issues"
  },
  "dataset": {
    "title": "CBBD Open Data - Anais e Trabalhos Científicos (1954–2026)",
    "subtitle": "Acervo Histórico e Preservação Digital dos Anais da FEBAB",
    "description": "Base de dados aberta contendo todos os trabalhos científicos publicados nos anais do Congresso Brasileiro de Biblioteconomia, Documentação e Ciência da Informação (CBBD) de 1954 a 2026, promovido pela FEBAB, disponibilizada sob princípios FAIR e BOAI.",
    "version": "1.0.0",
    "doi": "10.5281/zenodo.pending",
    "license": "Code: GNU GPLv3 | Data: CC BY-NC-SA 4.0 (Uso acadêmico; vedada ingestão comercial de IA)",
    "entityName": "articles",
    "singularName": "Artigo",
    "pluralName": "Artigos",
    "primaryKey": "id",
    "secondaryKey": "doi"
  },
  "schema": {
    "searchFields": [
      "title",
      "abstract",
      "authors",
      "keywords",
      "city",
      "state",
      "edition",
      "source_platform"
    ],
    "facets": [
      {
        "key": "year",
        "label": "Edição / Ano",
        "type": "number",
        "multi": true,
        "targetField": "year"
      },
      {
        "key": "author",
        "label": "Autor",
        "type": "string",
        "targetField": "authors"
      },
      {
        "key": "keyword",
        "label": "Palavra-chave / Tópico",
        "type": "string",
        "targetField": "keywords"
      },
      {
        "key": "edition",
        "label": "Número da Edição",
        "type": "string",
        "targetField": "edition"
      },
      {
        "key": "platform",
        "label": "Plataforma de Acesso",
        "type": "string",
        "targetField": "source_platform"
      },
      {
        "key": "state",
        "label": "UF Sede",
        "type": "string",
        "targetField": "state"
      }
    ],
    "sortFields": [
      {
        "key": "year",
        "label": "Ano de Edição"
      },
      {
        "key": "title",
        "label": "Título"
      },
      {
        "key": "edition",
        "label": "Número da Edição"
      }
    ]
  },
  "stats": {
    "topLists": [
      {
        "key": "topAuthors",
        "label": "Autores Mais Prolíficos",
        "sourceField": "authors",
        "limit": 10
      },
      {
        "key": "topKeywords",
        "label": "Palavras-chave Mais Frequentes",
        "sourceField": "keywords",
        "limit": 10
      },
      {
        "key": "topEditions",
        "label": "Edições com Mais Trabalhos",
        "sourceField": "edition",
        "limit": 10
      },
      {
        "key": "topStates",
        "label": "Distribuição Geográfica (UF)",
        "sourceField": "state",
        "limit": 10
      }
    ],
    "breakdowns": [
      {
        "key": "yearDistribution",
        "label": "Distribuição por Ano",
        "sourceField": "year"
      }
    ]
  }
}
